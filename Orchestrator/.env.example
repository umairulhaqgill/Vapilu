# Address of your already-running STT Service, including its own auth token.
STT_SERVICE_URL=ws://localhost:8000/ws/transcribe
STT_SERVICE_TOKEN=same_value_as_STT_SERVICE_TOKEN_in_the_stt-service_.env

# Address of your already-running NLU/LLM Service, including its own auth token.
NLU_SERVICE_URL=http://localhost:8002/reply
NLU_SERVICE_TOKEN=same_value_as_NLU_SERVICE_TOKEN_in_the_nlu-service_.env

# Shared secret required to connect to the Orchestrator's WebSocket.
# Pick any random string.
ORCHESTRATOR_TOKEN=choose_a_different_random_secret_string_here

# Address of your already-running Connector Gateway, including its own
# auth token - this is what actually runs an action node's connector call
# (booking, calendar, etc.) instead of faking success.
CONNECTOR_GATEWAY_URL=http://localhost:8005
CONNECTOR_GATEWAY_TOKEN=same_value_as_CONNECTOR_GATEWAY_TOKEN_in_the_connector-gateway_.env
