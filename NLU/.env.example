# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
NLU_MODEL=anthropic/claude-haiku-4.5

# Shared secret required to call this service's /reply endpoint.
# Pick any random string (different from the other services' tokens).
NLU_SERVICE_TOKEN=choose_a_different_random_secret_string_here

# --- Alternative: a local Ollama server instead of OpenRouter ---
# Useful when out of OpenRouter credits, or for offline dev. NLU_BASE_URL
# is the Ollama server ROOT (no /v1) - this backend speaks Ollama's native
# /api/chat, not its OpenAI-compat layer, because think=False (needed to
# stop hybrid-reasoning models like qwen3 burning the whole token budget
# on chain-of-thought before answering) only works on the native endpoint.
# No API key needed. The Ollama host must have OLLAMA_HOST=0.0.0.0 set and
# be restarted - by default it only listens on localhost, invisible to
# other LAN machines.
#NLU_PROVIDER=ollama
#NLU_BASE_URL=http://192.168.1.125:11434
#NLU_MODEL=qwen3.5:4b
