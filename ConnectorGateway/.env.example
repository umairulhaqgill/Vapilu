# Shared secret required to call this service's /call and /connectors
# endpoints. Pick any random string (different from the other services').
CONNECTOR_GATEWAY_TOKEN=choose_a_different_random_secret_string_here

# --- Per-tenant connector settings storage ---
# Set CONNECTOR_DB_URL to use a database (same "vapilu" database the other
# services use - a new table, connector_configs). Leave unset/commented to
# fall back to JSON files in CONNECTOR_DATA_DIR (no database needed).
CONNECTOR_DB_URL=mysql+pymysql://root:yourpassword@localhost:3306/vapilu
CONNECTOR_DATA_DIR=connector_configs
