# Path to the downloaded Piper voice model (.onnx file). See README for how
# to download one - this file does not exist until you download it.
PIPER_MODEL_PATH=voices/en_US-amy-medium.onnx

# Shared secret required to connect to this service's WebSocket.
# Pick any random string (different from the other services' tokens).
TTS_SERVICE_TOKEN=choose_a_different_random_secret_string_here
