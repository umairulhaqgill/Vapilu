# --- Storage backend ---
# Set TENANT_DB_URL to use a database. Leave it unset/commented to fall back
# to JSON files in TENANT_DATA_DIR (no database needed).
#
# MySQL (current):
TENANT_DB_URL=mysql+pymysql://root:yourpassword@localhost:3306/vapilu
#
# PostgreSQL later - only this line changes, no code edits:
# TENANT_DB_URL=postgresql+psycopg://user:password@localhost:5432/vapilu
#
# SQLite, if you want zero setup:
# TENANT_DB_URL=sqlite:///tenants.db

# Only used when TENANT_DB_URL is unset (JSON file fallback).
TENANT_DATA_DIR=tenants

# Shared secret required to read or write tenant configs.
# Pick any random string (different from the other services' tokens).
TENANT_SERVICE_TOKEN=choose_a_different_random_secret_string_here
